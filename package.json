{
  "name": "v-github-icon",
  "version": "3.4.0",
  "private": false,
  "description": "Vue 3 component for rendering GitHub Octicons (1,800+ icons) with full TypeScript types and tree-shakable ESM output.",
  "keywords": [
    "GitHub Icon",
    "git icon",
    "v-github-icon",
    "vue component"
  ],
  "homepage": "https://v-github-icon.vinayakkulkarni.dev",
  "bugs": {
    "url": "https://github.com/vinayakkulkarni/v-github-icon/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Vinayak Kulkarni",
    "email": "inbox.vinayak@gmail.com",
    "url": "https://vinayakkulkarni.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinayakkulkarni/v-github-icon.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./dist/index.css": "./dist/index.css"
  },
  "scripts": {
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "typecheck": "vue-tsc --noEmit",
    "build": "vp pack",
    "test": "vp test run",
    "demo:dev": "pnpm --filter @vinayakkulkarni/v-github-icon-example run dev",
    "demo:build": "pnpm run build && pnpm --filter @vinayakkulkarni/v-github-icon-example run build",
    "deploy": "pnpm run demo:build && wrangler deploy",
    "prepare": "is-ci || husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tsdown/css": "^0.23.2",
    "@types/node": "^26.6.5",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "lint-staged": "^17.6.0",
    "typescript": "^6.0.3",
    "unplugin-vue": "^8.0.0",
    "vite-plus": "^1.4.0",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.152.0"
  },
  "peerDependencies": {
    "vue": "^3.5.27"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.x"
    }
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
